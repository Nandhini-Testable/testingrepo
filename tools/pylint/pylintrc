[MAIN]
py-version = 3.7
ignore-paths = ^tests/.*$
jobs = 1
suggestion-mode = yes

[MESSAGES CONTROL]
# analysis/ is a planted fixture directory. Nothing there is disabled -- the
# violations are the point.
disable =
    missing-module-docstring,
    too-few-public-methods

[FORMAT]
max-line-length = 100

[DESIGN]
max-args = 9
max-branches = 12
max-complexity = 10

[SIMILARITIES]
min-similarity-lines = 25
ignore-comments = yes
ignore-docstrings = yes
ignore-imports = no
