{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "mocha",
  "reporters": [
    "clear-text",
    "json"
  ],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.js"
  ],
  "mochaOptions": {
    "spec": [
      "tests/**/*.test.js"
    ]
  },
  "plugins": [
    "@stryker-mutator/mocha-runner"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation.json"
  }
}
