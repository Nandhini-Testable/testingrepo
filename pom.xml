<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.pramora.testable</groupId>
  <artifactId>jv-073</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Testable Java corpus JV-073</name>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Empty default so @{argLine} below resolves when no coverage agent is attached.
         JaCoCo's prepare-agent sets this property to its -javaagent option. -->
    <argLine></argLine>
    <!-- Small JVMs for forked test processes so they start under a tight address-space limit. -->
    <test.jvm.memory>-Xmx256m -XX:CompressedClassSpaceSize=64m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=48m -XX:+UseSerialGC</test.jvm.memory>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>commons-collections</groupId>
      <artifactId>commons-collections</artifactId>
      <version>3.2.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-text</artifactId>
      <version>1.9</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.9.10.1</version>
    </dependency>
    <dependency>
      <groupId>log4j</groupId>
      <artifactId>log4j</artifactId>
      <version>1.2.17</version>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>1.30</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>jv-073-1.0.0</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <!-- Explicit config beats -Dmaven.test.skip=true on the command line, so
             test classes are always compiled (PIT needs them). -->
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration><skip>false</skip></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>default-testResources</id>
            <configuration><skip>false</skip></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- @{argLine} keeps the JaCoCo agent; the rest caps the forked test JVM. -->
          <argLine>@{argLine} ${test.jvm.memory}</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive><manifest>
            <addClasspath>true</addClasspath>
            <classpathPrefix>lib/</classpathPrefix>
            <mainClass>com.pramora.testable.app.Main</mainClass>
          </manifest></archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions><execution>
          <id>copy-dependencies</id><phase>package</phase><goals><goal>copy-dependencies</goal></goals>
          <configuration><outputDirectory>${project.build.directory}/lib</outputDirectory></configuration>
        </execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.26.0</version>
        <configuration>
          <rulesets><ruleset>${project.basedir}/tools/pmd/ruleset.xml</ruleset></rulesets>
          <targetJdk>21</targetJdk>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration><configLocation>${project.basedir}/tools/checkstyle/checkstyle.xml</configLocation></configuration>
        <dependencies>
          <dependency><groupId>com.puppycrawl.tools</groupId><artifactId>checkstyle</artifactId><version>10.26.1</version></dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.8.6.6</version>
        <configuration>
          <excludeFilterFile>${project.basedir}/tools/spotbugs/exclude.xml</excludeFilterFile>
          <plugins>
            <plugin><groupId>com.h3xstream.findsecbugs</groupId><artifactId>findsecbugs-plugin</artifactId><version>1.13.0</version></plugin>
          </plugins>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>1.30.0</version>
        <configuration>
          <!-- Explicit config beats -DskipTests on the command line. -->
          <skipTests>false</skipTests>
          <targetClasses><param>com.pramora.testable.*</param></targetClasses>
          <targetTests><param>com.pramora.testable.*Test</param></targetTests>
          <!-- Cap each PIT minion JVM so it starts under a tight address-space limit. -->
          <jvmArgs>
            <value>-Xmx256m</value>
            <value>-XX:CompressedClassSpaceSize=64m</value>
            <value>-XX:MaxMetaspaceSize=192m</value>
            <value>-XX:ReservedCodeCacheSize=48m</value>
            <value>-XX:+UseSerialGC</value>
          </jvmArgs>
          <threads>1</threads>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>13.0.0</version>
        <configuration><formats><format>HTML</format><format>JSON</format></formats></configuration>
      </plugin>
    </plugins>
  </build>
</project>
